# Local development configuration. The Docker deployment uses docker-compose.yml.
NODE_ENV=development
INLET_LOG_LEVEL=info
INLET_PORT=3000
INLET_PUBLIC_URL=http://localhost:3000

INLET_DATABASE_URL=postgresql://inlet:inlet@127.0.0.1:5433/inlet
INLET_SESSION_SECRET=change-me-to-at-least-32-random-characters
INLET_ADMIN_EMAIL=admin@inlet.local
INLET_ADMIN_PASSWORD=choose-a-strong-password
INLET_ADMIN_NAME=Inlet Admin
INLET_TRUSTED_PROXIES=false

INLET_S3_ENDPOINT=http://127.0.0.1:9010
INLET_S3_REGION=us-east-1
INLET_S3_BUCKET=inlet
INLET_S3_ACCESS_KEY_ID=inletdev
INLET_S3_SECRET_ACCESS_KEY=inletdevsecret
INLET_S3_FORCE_PATH_STYLE=true

INLET_INTENT_TTL_MINUTES=30
INLET_PENDING_UPLOAD_EXPIRY_DAYS=1

# --- Malware scanning of uploads (Release 2, optional) ----------------------
# A ClamAV clamd host enables scanning of every uploaded screenshot, in addition
# to the WebP re-encoding that always runs. Leave unset to disable.
# INLET_CLAMAV_HOST=clamav
# INLET_CLAMAV_PORT=3310
# Whether an unreachable scanner blocks uploads. Off by default, so a scanner
# outage records the upload as unscanned rather than stopping collection.
# INLET_MALWARE_SCAN_REQUIRED=false

# --- Analytics event store (Release 8, optional) ----------------------------
# ClickHouse. Unset means no event store: analytics is off and everything else runs
# unchanged. The URL carries the credentials of the user that writes (inserts,
# deletes, the migrations' DDL); the read URL those of a read-only user. Without a
# read URL, reads use the writer with readonly=2. The database is created at start.
#
# For `npm run dev`, uncomment these three: they are the ClickHouse `npm run
# services:up` runs on port 8124. Leave them commented for the Docker deployment,
# which points at its own `clickhouse` service (docs/DEPLOYMENT.md, "Analytics"),
# and set them only to use a ClickHouse of your own.
# INLET_CLICKHOUSE_URL=http://inlet:inlet@127.0.0.1:8124
# INLET_CLICKHOUSE_READ_URL=http://inlet_reader:inlet_reader@127.0.0.1:8124
# INLET_CLICKHOUSE_DATABASE=inlet
#
# Bundled service only: the two users' passwords. Set both before the first start.
# INLET_CLICKHOUSE_PASSWORD=
# INLET_CLICKHOUSE_READER_PASSWORD=
#
# The country of each analytics event (AN-033): the header your trusted reverse proxy
# reports it in (believed only through a proxy INLET_TRUSTED_PROXIES names), and another
# IP-to-country database than the bundled DB-IP Lite file.
# INLET_COUNTRY_HEADER=CF-IPCountry
# INLET_IP_COUNTRY_DB=

# --- Slack notifications (Release 4, optional) ------------------------------
# Which origins a notification may be POSTed to. Slack only, by default, which is
# what makes an operator-supplied webhook URL unable to reach anything else.
# Widen it only to target a Slack-compatible relay, and only knowingly: every
# origin listed here is somewhere this server can be made to send a request.
# INLET_SLACK_WEBHOOK_ORIGINS=https://hooks.slack.com

# --- Optional: running the live Slack test ---------------------------------
# Everything about Slack delivery is tested without the network. This variable is
# only for the opt-in test that posts one real message to a real channel, proving
# Slack itself accepts what Inlet builds:
#
#   INLET_TEST_SLACK_WEBHOOK_URL=... npm run test:live -w @inlet/api
#
# Leave it empty and that test skips. A webhook URL is the whole authorization to
# post in a workspace, so keep it here — this file's real counterpart, .env, is not
# tracked — and never in a committed file.
INLET_TEST_SLACK_WEBHOOK_URL=
