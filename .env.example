# Local development configuration. The Docker deployment uses docker-compose.yml.
NODE_ENV=development
INLET_LOG_LEVEL=info
INLET_PORT=3000
INLET_PUBLIC_URL=http://localhost:3000

INLET_DATABASE_URL=postgresql://inlet:inlet@127.0.0.1:5433/inlet
INLET_SESSION_SECRET=change-me-to-at-least-32-random-characters
INLET_ADMIN_EMAIL=admin@inlet.local
INLET_ADMIN_PASSWORD=choose-a-strong-password
INLET_ADMIN_NAME=Inlet Admin
INLET_TRUSTED_PROXIES=false

INLET_S3_ENDPOINT=http://127.0.0.1:9010
INLET_S3_REGION=us-east-1
INLET_S3_BUCKET=inlet
INLET_S3_ACCESS_KEY_ID=inletdev
INLET_S3_SECRET_ACCESS_KEY=inletdevsecret
INLET_S3_FORCE_PATH_STYLE=true

INLET_INTENT_TTL_MINUTES=30
INLET_PENDING_UPLOAD_EXPIRY_DAYS=1
