{
  "name": "inlet-sdk",
  "version": "0.2.0",
  "description": "The Inlet client SDK. Feedback collection and crash reports, with Node, browser, Electron, React and React Native entries.",
  "license": "MIT",
  "author": "Guilhem Duch\u00e9",
  "homepage": "https://github.com/guiguito/inlet/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guiguito/inlet.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/guiguito/inlet/issues"
  },
  "keywords": [
    "inlet",
    "nps",
    "survey",
    "forms",
    "feedback",
    "crash-reporting",
    "error-tracking",
    "error-reporting",
    "self-hosted",
    "electron",
    "browser",
    "node",
    "sdk",
    "privacy",
    "react-native"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "crash",
    "feedback"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./crash": {
      "types": "./dist/crash/index.d.ts",
      "import": "./dist/crash/index.js",
      "require": "./dist/crash/index.cjs"
    },
    "./crash/node": {
      "types": "./dist/crash/node.d.ts",
      "import": "./dist/crash/node.js",
      "require": "./dist/crash/node.cjs"
    },
    "./crash/browser": {
      "types": "./dist/crash/browser.d.ts",
      "import": "./dist/crash/browser.js",
      "require": "./dist/crash/browser.cjs"
    },
    "./crash/electron": {
      "types": "./dist/crash/electron.d.ts",
      "import": "./dist/crash/electron.js",
      "require": "./dist/crash/electron.cjs"
    },
    "./crash/electron-renderer": {
      "types": "./dist/crash/electron-renderer.d.ts",
      "import": "./dist/crash/electron-renderer.js",
      "require": "./dist/crash/electron-renderer.cjs"
    },
    "./crash/react": {
      "types": "./dist/crash/react.d.ts",
      "import": "./dist/crash/react.js",
      "require": "./dist/crash/react.cjs"
    },
    "./crash/react-native": {
      "types": "./dist/crash/react-native.d.ts",
      "import": "./dist/crash/react-native.js",
      "require": "./dist/crash/react-native.cjs"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "import": "./dist/feedback/index.js",
      "require": "./dist/feedback/index.cjs"
    },
    "./feedback/node": {
      "types": "./dist/feedback/node.d.ts",
      "import": "./dist/feedback/node.js",
      "require": "./dist/feedback/node.cjs"
    },
    "./feedback/browser": {
      "types": "./dist/feedback/browser.d.ts",
      "import": "./dist/feedback/browser.js",
      "require": "./dist/feedback/browser.cjs"
    },
    "./feedback/electron": {
      "types": "./dist/feedback/electron.d.ts",
      "import": "./dist/feedback/electron.js",
      "require": "./dist/feedback/electron.cjs"
    },
    "./feedback/react": {
      "types": "./dist/feedback/react.d.ts",
      "import": "./dist/feedback/react.js",
      "require": "./dist/feedback/react.cjs"
    },
    "./feedback/react-native": {
      "types": "./dist/feedback/react-native.d.ts",
      "import": "./dist/feedback/react-native.js",
      "require": "./dist/feedback/react-native.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm --prefix ../.. run build:shared && npm run build",
    "test:metro": "node test/metro/bundle.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@inlet/shared": "*",
    "@types/node": "^22.20.1",
    "esbuild": "*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
